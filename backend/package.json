{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate --config config/config.cjs",
    "migrate:status": "npx sequelize-cli db:migrate:status --config config/config.cjs",
    "migrate:undo": "npx sequelize-cli db:migrate:undo --config config/config.cjs",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all --config config/config.cjs",
    "seed": "npx sequelize-cli db:seed:all --config config/config.cjs"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.1",
    "papaparse": "^5.5.3",
    "sequelize": "^6.32.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.0"
  }
}
